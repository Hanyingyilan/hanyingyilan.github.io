{
  "title": "為家鄉獻出勇氣",
  "description": "韓瑩談回鄉參選及年輕世代投入地方服務。",
  "sourceURL": "https://www.facebook.com/reel/1144892157970700/",
  "sourceAuthor": "韓瑩",
  "sourceReviewedAt": "2026-11-02",
  "published": null,
  "durationSeconds": 47.203991,
  "audioReview": "pending-human",
  "audioReviewedAt": null,
  "transcriptionMethod": "逐格核對燒錄字幕；以本機語音辨識交叉比對，未宣稱人工聽辨驗收。",
  "cues": [
    {
      "start": 0,
      "end": 1,
      "text": "四月份的時候"
    },
    {
      "start": 1,
      "end": 2.25,
      "text": "正式從黨的提名徵召"
    },
    {
      "start": 2.25,
      "end": 3.5,
      "text": "要回到宜蘭市"
    },
    {
      "start": 3.5,
      "end": 4.25,
      "text": "來參選市長"
    },
    {
      "start": 4.25,
      "end": 5.25,
      "text": "很多人都說"
    },
    {
      "start": 5.25,
      "end": 6.75,
      "text": "這是一個不可能的任務"
    },
    {
      "start": 6.75,
      "end": 7.5,
      "text": "不過我很高興"
    },
    {
      "start": 7.5,
      "end": 9,
      "text": "在我參選之後"
    },
    {
      "start": 9,
      "end": 10.5,
      "text": "看到更多的年輕夥伴"
    },
    {
      "start": 10.5,
      "end": 11.25,
      "text": "抱持著"
    },
    {
      "start": 11.25,
      "end": 12.5,
      "text": "想要改變家鄉的心"
    },
    {
      "start": 12.5,
      "end": 14.5,
      "text": "選擇回到地方來服務"
    },
    {
      "start": 14.5,
      "end": 15.5,
      "text": "我想這幾次"
    },
    {
      "start": 15.5,
      "end": 17.25,
      "text": "看到撲馬市長提到的一句話"
    },
    {
      "start": 17.25,
      "end": 17.75,
      "text": "我深受感動"
    },
    {
      "start": 17.75,
      "end": 18.75,
      "text": "不要灰心"
    },
    {
      "start": 18.75,
      "end": 19.75,
      "text": "不要喪志"
    },
    {
      "start": 19.75,
      "end": 20.75,
      "text": "因為"
    },
    {
      "start": 20.75,
      "end": 21.25,
      "text": "我們來了"
    },
    {
      "start": 21.25,
      "end": 22.5,
      "text": "我們年輕世代"
    },
    {
      "start": 22.5,
      "end": 23.25,
      "text": "有勇氣"
    },
    {
      "start": 23.25,
      "end": 24,
      "text": "想要改變"
    },
    {
      "start": 24,
      "end": 24.75,
      "text": "自己的家鄉"
    },
    {
      "start": 24.75,
      "end": 26,
      "text": "改變自己的未來"
    },
    {
      "start": 26,
      "end": 27.25,
      "text": "這就是一個"
    },
    {
      "start": 27.25,
      "end": 28,
      "text": "民進黨"
    },
    {
      "start": 28,
      "end": 29.25,
      "text": "所要提名我們這些"
    },
    {
      "start": 29.25,
      "end": 30.5,
      "text": "優秀的年輕人才"
    },
    {
      "start": 30.5,
      "end": 32.75,
      "text": "回到故鄉最重大的原因"
    },
    {
      "start": 32.75,
      "end": 33.5,
      "text": "洋流"
    },
    {
      "start": 33.5,
      "end": 34.5,
      "text": "是一個正向樂觀"
    },
    {
      "start": 34.5,
      "end": 35.25,
      "text": "我希望未來"
    },
    {
      "start": 35.25,
      "end": 37,
      "text": "洋流流到宜蘭市"
    },
    {
      "start": 37,
      "end": 37.75,
      "text": "成為"
    },
    {
      "start": 37.75,
      "end": 39.25,
      "text": "新韓流"
    },
    {
      "start": 39.25,
      "end": 39.75,
      "text": "未來"
    },
    {
      "start": 39.75,
      "end": 40.75,
      "text": "韓瑩有機會"
    },
    {
      "start": 40.75,
      "end": 41.5,
      "text": "成為大家的"
    },
    {
      "start": 41.5,
      "end": 42.5,
      "text": "宜蘭市長"
    },
    {
      "start": 42.5,
      "end": 43.25,
      "text": "希望大家"
    },
    {
      "start": 43.25,
      "end": 44.75,
      "text": "給我們這些人才"
    },
    {
      "start": 44.75,
      "end": 45.5,
      "text": "更多的鼓勵"
    },
    {
      "start": 45.5,
      "end": 46.5,
      "text": "更多的支持"
    },
    {
      "start": 46.5,
      "end": 47.203991,
      "text": "謝謝大家"
    }
  ]
}
